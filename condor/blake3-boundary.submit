universe = vanilla
initialdir = /u/ayman27/activation-checkpoint-integrity
executable = /bin/bash
arguments = scripts/run_condor_followthrough.sh boundary
output = artifacts/condor/blake3-$(Cluster).$(Process).out
error = artifacts/condor/blake3-$(Cluster).$(Process).err
log = artifacts/condor/blake3-$(Cluster).log
environment = "CONDOR_CLUSTER_ID=$(Cluster) CONDOR_PROCESS_ID=$(Process)"
notification = Never
should_transfer_files = NO
request_cpus = 4
request_memory = 24GB
request_disk = 15GB
request_gpus = 1
requirements = TARGET.GPUSlot && TARGET.Eldar && TARGET.GTX1080Ti
+GPUJob = true
+Group = "UNDER"
+Project = "OPERATING_DISTRIBUTED_SYSTEMS"
+ProjectDescription = "BLAKE3 checkpoint digest conformance and 40M timing"
queue 1
